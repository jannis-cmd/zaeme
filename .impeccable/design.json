      "html": "<nav class=\"ds-nav\" aria-label=\"Hauptnavigation\"><button class=\"ds-active\">Für Angehörige</button><button>Spenden</button></nav>",
      "css": ".ds-nav{display:flex;gap:24px}.ds-nav button{font-family:\"Nunito Sans\",\"Segoe UI\",sans-serif;position:relative;min-height:44px;padding:8px 4px;border:0;background:none;color:var(--muted,#5a6360);font-size:15px;font-weight:700}.ds-nav button:hover{color:var(--teal-dark,#116b5b)}.ds-nav .ds-active{color:var(--talk-brown,#7a5c3a)}.ds-nav .ds-active:after{content:\"\";position:absolute;left:4px;right:4px;bottom:3px;height:2px;border-radius:2px;background:currentColor}.ds-nav button:focus-visible{outline:3px solid var(--teal,#19937e);outline-offset:3px;}"
    },
    {
      "name": "Friendship book",
      "kind": "custom",
      "refersTo": "friendship-book",
      "description": "Persistent cover color with a separate selected state.",
      "html": "<button class=\"ds-book\" aria-pressed=\"true\"><strong>Marta</strong><small>Schweizerdeutsch</small><span class=\"ds-selection\"><svg width=\"24\" height=\"24\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M5 13L9 17L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg></span></button>",
      "css": ".ds-book{font-family:\"Nunito Sans\",\"Segoe UI\",sans-serif;position:relative;width:100%;min-height:284px;padding:72px 28px 36px;display:flex;flex-direction:column;justify-content:flex-end;border:0;border-radius:5px 16px 16px 5px;background:var(--teal-dark,#116b5b);color:white;text-align:left;box-shadow:3px 4px 0 white,4px 5px 0 #d9cfc0,0 10px 22px #2e383014;outline:2px solid var(--teal-dark,#116b5b);outline-offset:5px;transition:transform 180ms cubic-bezier(.2,.85,.25,1)}.ds-book:before{content:\"\";position:absolute;top:0;bottom:0;left:14px;border-left:1px solid #ffffff35}.ds-book strong{display:block;font-size:28px;line-height:1.2;letter-spacing:-.02em}.ds-book small{display:block;margin-top:8px;font-size:14px}.ds-selection{position:absolute;left:12px;top:12px;width:44px;height:44px;display:grid;place-items:center}.ds-selection svg{width:20px;height:20px}.ds-book:hover{transform:translateY(-3px)}.ds-book:focus-visible{outline:3px solid var(--teal,#19937e);outline-offset:3px;}"
    },
