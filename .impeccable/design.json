      "refersTo": "field",
      "description": "A labeled, readable profile input.",
      "html": "<label class=\"ds-label\">Vorname<input class=\"ds-field\" placeholder=\"z. B. Marta\"></label>",
      "css": ".ds-label{font-family:\"Nunito Sans\",\"Segoe UI\",sans-serif;display:block;color:var(--ink,#2e3830);font-size:15px;font-weight:600}.ds-field{font-family:\"Nunito Sans\",\"Segoe UI\",sans-serif;display:block;width:100%;min-height:44px;margin-top:9px;padding:10px 12px;border:1px solid var(--line,#e4ddd3);border-radius:8px;background:var(--bg,#f7f4ef);color:var(--ink,#2e3830);font-size:16px;font-weight:400;line-height:1.45}.ds-field::placeholder{color:var(--muted,#5a6360);opacity:1}.ds-field:focus{outline:2px solid var(--teal-dark,#116b5b);outline-offset:2px;border-color:var(--teal-dark,#116b5b)}"
    },
