ELEVENLABS_FEMALE_VOICE_ID=MGG5Irb57ATHvyIeTEYo
# Infomaniak AI Services (Gemma 4). Replace PRODUCT_ID with the AI Services product ID.
ZAEME_MODEL_URL=https://api.infomaniak.com/2/ai/PRODUCT_ID/openai
ZAEME_MODEL_ID=google/gemma-4-31B-it
# Keep the actual API key in an owner-readable file outside this repository.
ZAEME_MODEL_API_KEY_FILE=/absolute/path/to/infomaniak-api-key
# Main voice mode: private ElevenLabs Agent using the same Infomaniak model.
ELEVENLABS_AGENTS_KEY_FILE=/absolute/path/to/elevenlabs-agents-key
ZAEME_AGENTS_CONFIG=/absolute/path/to/agents-config.json
ZAEME_AGENTS_LEDGER=/absolute/path/to/agents-budget.json
# Explicit monthly app budget in whole minutes; unset means classic fallback.
# Verify the allowance in your own account before choosing a limit.
ZAEME_AGENTS_MONTHLY_MINUTES=
# Run python3 agents_service.py --setup once after configuring these variables.
# Classic mode remains available: python3 agents_gateway.py --backend classic
# Modal is an alternative model backend; see docs/DEVELOPMENT.md.
# The legacy example's HEARTH_ACCESS_CODE is not used by the current app.
