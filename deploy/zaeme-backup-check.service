[Unit]
Description=Check encrypted Zäme backup freshness
After=zaeme-backup.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I /usr/local/sbin/myna-backup-check --directory /var/backups/zaeme/encrypted --pattern zaeme-*.tar.gz.age
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M
