[Unit]
Description=Encrypted Zäme database and recovery backup
After=zaeme-web.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/local/sbin/zaeme-backup
UMask=0077
RuntimeDirectory=zaeme-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/zaeme /run/zaeme-backup
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
Nice=10
